{
  "name": "functions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/functions/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/functions/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/functions"],
      "options": {
        "jestConfig": "libs/functions/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "libs/functions/lib",
        "main": "libs/functions/src/index.ts",
        "tsConfig": "libs/functions/tsconfig.json",
        "rootDir": "libs/functions/src"
      }
    }
  }
}
