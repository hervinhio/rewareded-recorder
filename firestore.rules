rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Publishers/{publisher} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        (get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role in ["admin", "root", "group_admin"] ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'auxilaryPionierFor'])
        );
    }

    match /Repports/{report} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /Groups/{group} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role in ["admin", "root", "group_admin"];
    }

    match /Users/{user} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /Notifications/{notification} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true
    }

    match /Submissions/{submission} {
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role in ["admin", "root", "group_admin"];

      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /Config/{config} {
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        request.auth.uid == config;

      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /Stats/{unique} {
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;

      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /AttendanceRecords/{record} {
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;

      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /SpecialMonths/{record} {
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;

      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true;
    }

    match /Cases/{caseId} {
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        request.resource.data.creatorId == request.auth.uid;

      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.validated == true &&
        (get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role in ["root", "admin"] ||
         resource.data.creatorId == request.auth.uid);
    }
  }
}
