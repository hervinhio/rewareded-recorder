  "homepage": "./",
  "scripts": {
    "swap-dev-env": "node -e \"require('fs').rename('apps/rewarded-keeper/src/app/environment.ts', 'apps/rewarded-keeper/src/app/environment.dev.ts', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "swap-prod-env": "node -e \"require('fs').rename('apps/rewarded-keeper/src/app/environment.prod.ts', 'apps/rewarded-keeper/src/app/environment.ts', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "swap-back-prod-env": "node -e \"require('fs').rename('apps/rewarded-keeper/src/app/environment.ts', 'apps/rewarded-keeper/src/app/environment.prod.ts', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "swap-back-dev-env": "node -e \"require('fs').rename('apps/rewarded-keeper/src/app/environment.dev.ts', 'apps/rewarded-keeper/src/app/environment.ts', function(err) { if (err) console.log(err); console.log('File successfully renamed!') })\"",
    "start": "nx serve",
    "prebuild": "yarn swap-dev-env && yarn swap-prod-env",
    "build": "nx build && cp -r dist/apps/rewarded-keeper/* ./cordova/www",
    "build:ios": "yarn build && pushd cordova && cordova build ios && popd",
    "build:android": "yarn build && pushd cordova && cordova build android && popd",
    "postbuild": "yarn swap-back-prod-env && yarn swap-back-dev-env",
    "build:dev": "nx build",
    "test": "nx test",
    "prettify": "prettier --write apps/**/*.ts apps/**/*.tsx",
    "lint": "eslint apps"
  },
  "private": true,
