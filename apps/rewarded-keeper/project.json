{
  "name": "rewarded-keeper",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/rewarded-keeper/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/rewarded-keeper",
        "index": "apps/rewarded-keeper/src/index.html",
        "baseHref": "/",
        "main": "apps/rewarded-keeper/src/main.tsx",
        "polyfills": "apps/rewarded-keeper/src/polyfills.ts",
        "tsConfig": "apps/rewarded-keeper/tsconfig.app.json",
        "assets": [
          "apps/rewarded-keeper/src/favicon.ico",
          "apps/rewarded-keeper/src/worker.js",
          "apps/rewarded-keeper/src/manifest.json",
          "apps/rewarded-keeper/src/assets"
        ],
        "styles": ["apps/rewarded-keeper/src/styles.scss"],
        "scripts": [],
        "webpackConfig": "@nx/react/plugins/webpack"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/rewarded-keeper/src/environments/environment.ts",
              "with": "apps/rewarded-keeper/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false
        }
      }
    },
    "serve": {
      "executor": "@nx/webpack:dev-server",
      "options": {
        "buildTarget": "rewarded-keeper:build",
        "hmr": true
      },
      "configurations": {
        "production": {
          "buildTarget": "rewarded-keeper:build:production",
          "hmr": false
        },
        "development": {
          "buildTarget": "rewarded-keeper:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/rewarded-keeper/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/rewarded-keeper"],
      "options": {
        "jestConfig": "apps/rewarded-keeper/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
